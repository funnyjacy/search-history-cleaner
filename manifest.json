{
  "manifest_version": 3,
  "name": "搜索历史清理器",
  "description": "实时删除搜索引擎结果页的浏览记录，使地址栏不再弹出搜索历史",
  "version": "1.0.0",
  "permissions": ["history"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "搜索历史清理器",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
